# Qobuz Cloudflare Worker Backend Environment Variables
# Copy this file to .env and configure your variables

# Optional static App ID and Secret (extracted automatically if left blank)
QOBUZ_APP_ID=798273057
QOBUZ_APP_SECRET=
QOBUZ_USER_AUTH_TOKEN=

# Optional account login credentials for automatic authentication on boot/requests
QOBUZ_EMAIL=
QOBUZ_PASSWORD=

# Default Audio Quality:
# 5  = MP3 320kbps
# 6  = FLAC 16-bit / 44.1kHz (CD Lossless)
# 7  = FLAC 24-bit / <= 96kHz (Hi-Res)
# 27 = FLAC 24-bit / > 96kHz (Hi-Res+)
DEFAULT_QUALITY=6

# Optional API Security: Set a secret key to protect this worker endpoint
# Clients must send header "X-API-Key: <your-key>" or query param "?key=<your-key>"
API_AUTH_KEY=

# CORS Origin control ("*" for public access)
ALLOWED_ORIGIN=*
