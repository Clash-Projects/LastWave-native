name = "qobuz-backend"
main = "src/index.js"
compatibility_date = "2024-04-01"
compatibility_flags = ["nodejs_compat"]

[vars]
# Account Pool JSON (for multi-account load balancing)
QOBUZ_ACCOUNTS_JSON = '[{"id":"acc_1","appId":"950096963","appSecret":"your_secret","userAuthToken":"your_token","userId":"your_id"}]'

# Single Account fallback
QOBUZ_APP_ID = ""
QOBUZ_APP_SECRET = ""
QOBUZ_USER_AUTH_TOKEN = ""
QOBUZ_USER_ID = ""
QOBUZ_EMAIL = ""
QOBUZ_PASSWORD = ""
DEFAULT_QUALITY = "6"
API_AUTH_KEY = ""
ALLOWED_ORIGIN = "*"
